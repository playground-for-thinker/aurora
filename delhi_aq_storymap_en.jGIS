    "8725760f-47d7-51d1-886e-7a9cf079b27c": {
      "type": "StorySegmentLayer",
      "name": "1. One line of air-quality warning that reaches a citizen",
      "visible": true,
      "parameters": {
        "zoom": 1.97,
        "extent": [
          -4452779.63,
          -6446275.84,
          35622237.05,
          11753184.62
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "<div style='font-size:16px; line-height:1.5; min-height:84vh;'><div style='font-size:.8em; color:#64748b; letter-spacing:.03em; margin:0 0 .5em;'>Aurora Earth-system AI · Delhi air-quality alerts</div><div style='background:#0f172a; color:#f8fafc; padding:.5em .8em; border-radius:14px; margin:.5em 0; font-size:.85em; line-height:1.4;'><div style='font-size:.75em; opacity:.7; margin-bottom:.15em;'>📱 The line a citizen receives (generated from the forecast)</div>[Air quality alert] Anand Vihar: peak AQI 500 (Severe) expected around 07 Nov 05:30 IST. Main pollutant PM10, PM2.5 up to 321 ug/m3. Even healthy people are affected.</div><ul style='margin:0 0 .5em 1.1em; padding:0;'><li style='margin:0 0 .35em 0;'>The 48-hour air quality of Delhi is forecast with <b>Aurora</b>, Microsoft Research's Earth-system AI.</li><li style='margin:0 0 .35em 0;'>The forecast becomes India's official scale (the CPCB air-quality index AQI and the staged GRAP measures) and messages in Hindi, English and Korean.</li><li style='margin:0 0 .35em 0;'>This story: why Delhi → what Aurora computes → how it reaches citizens → what the system does and what government must own.</li></ul><div style='font-size:.8em; color:#64748b;'>Weather: Aurora 1.5 · Pollutants: synthetic example · initial time 2025-11-05 12:00:00 UTC</div></div>",
          "image": "",
          "imageCaption": "",
          "paneAlignment": "end",
          "panelWidth": "34%"
        },
        "transition": {
          "type": "linear",
          "time": 1.5
        },
        "layerOverride": [
          {
            "targetLayer": "ee2531a6-23fa-5db3-8289-12a808582c05",
            "visible": false
