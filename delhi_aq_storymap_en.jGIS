    "a5861267-8d52-5bd6-b207-8ce9f6a34fa4": {
      "type": "StorySegmentLayer",
      "name": "10. What the system shows and what government and city must own",
      "visible": true,
      "parameters": {
        "zoom": 10.46,
        "extent": [
          8506701.53,
          3274212.69,
          8751604.41,
          3382011.46
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "<div style='font-size:16px; line-height:1.5; min-height:84vh;'><div style='font-size:.8em; color:#64748b; letter-spacing:.03em; margin:0 0 .5em;'>9 · Who does what</div><div style='background:#e6f3f7; border-left:6px solid #0b6e8f; padding:.45em .7em; border-radius:8px; margin:.5em 0; font-size:.9em; color:#1e293b;'><b style='color:#0b6e8f;'>What this system shows</b> · forecast → AQI and GRAP level → stagnant hours and probability → draft messages, briefing, maps. Automatic re-issue every 12 h. Postal code → site mapping demonstrated.</div><div style='background:#fff4e0; border-left:6px solid #b7791f; padding:.45em .7em; border-radius:8px; margin:.5em 0; font-size:.9em; color:#1e293b;'><b style='color:#b7791f;'>Government and city</b> · connecting and verifying the official monitors, bias correction, invoking and enforcing GRAP, the subscriber registry and personal channels (SMS, WhatsApp, app), health wording review, support for vulnerable groups, public education.</div><ul style='margin:0 0 .5em 1.1em; padding:0;'><li style='margin:0 0 .35em 0;'>The hand-off is clear: the system produces <b>evidence and drafts</b> every 12 hours; the authority owns <b>judgement, issuance and delivery</b>.</li><li style='margin:0 0 .35em 0;'>Personal messages (postal code → nearest site) are only completed inside a government channel that holds subscriber data.</li></ul></div>",
          "image": "",
          "imageCaption": "",
          "paneAlignment": "end",
          "panelWidth": "34%"
        },
        "transition": {
          "type": "linear",
          "time": 1.5
        },
