    "8a4709a9-6188-525f-a14d-c09895dfe651": {
      "type": "StorySegmentLayer",
      "name": "3. Aurora appears twice",
      "visible": true,
      "parameters": {
        "zoom": 7.65,
        "extent": [
          8111739.97,
          3061141.04,
          9826060.13,
          3829123.84
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "<div style='font-size:16px; line-height:1.5; min-height:84vh;'><div style='font-size:.8em; color:#64748b; letter-spacing:.03em; margin:0 0 .5em;'>2 · System · Weather: Aurora 1.5 · Pollutants: synthetic example</div><ul style='margin:0 0 .5em 1.1em; padding:0;'><li style='margin:0 0 .35em 0;'><b>Aurora</b> is an AI model that takes global analyses and forecasts the Earth's weather and atmospheric composition. One computer gives 48 hours in minutes.</li><li style='margin:0 0 .35em 0;'>The <b>air-pollution model</b> predicts concentrations directly but every 12 hours. <b>Aurora 1.5</b> predicts no pollutants but gives hourly wind and mixing height.</li><li style='margin:0 0 .35em 0;'>Together they answer \"how high\" and \"from what hour tonight stagnation sets in\".</li></ul><div style='background:#e6f3f7; border-left:6px solid #0b6e8f; padding:.45em .7em; border-radius:8px; margin:.5em 0; font-size:.9em; color:#1e293b;'><b style='color:#0b6e8f;'>What this system shows</b> · both models → AQI, GRAP level and stagnant hours at 10 sites → draft messages, all automatic. The thin grid on the map is the model's 0.25° cells.</div></div>",
          "image": "",
          "imageCaption": "",
          "paneAlignment": "end",
          "panelWidth": "34%"
        },
        "transition": {
          "type": "linear",
          "time": 1.5
        },
        "layerOverride": [
