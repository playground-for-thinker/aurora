    "32d648e1-bd87-5fdd-a179-2fee9a18edb6": {
      "type": "StorySegmentLayer",
      "name": "7. 18:30 IST, 저녁 경보",
      "visible": true,
      "parameters": {
        "zoom": 10.46,
        "extent": [
          8532638.97,
          3274212.69,
          8755277.95,
          3382011.46
