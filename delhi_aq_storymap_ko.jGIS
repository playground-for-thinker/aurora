    "b8b2a843-e052-5c13-83d0-5dbb2a59ed7b": {
      "type": "StorySegmentLayer",
      "name": "16. msresearch-aurora 스타터로 학습 루프 점검",
      "visible": true,
      "parameters": {
        "zoom": 7.65,
        "extent": [
