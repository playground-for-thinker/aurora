          {
            "targetLayer": "AQI 11월 7일 05:30 IST",
            "visible": false
          },
          {
            "targetLayer": "AQI 11월 7일 14:30 IST",
            "visible": false
          },
          {
            "targetLayer": "정체 확률 11월 7일 05:30 IST",
            "visible": false
          },
          {
            "targetLayer": "0.25° 격자 (Aurora 1.5)",
            "visible": false
          },
          {
            "targetLayer": "0.4° 셀 1개 (Aurora Air Pollution)",
            "visible": false
          },
          {
            "targetLayer": "10 m 바람 11월 6일 02:30 IST",
            "visible": false
          },
          {
            "targetLayer": "10 m 바람 11월 7일 05:30 IST",
            "visible": false
          },
          {
            "targetLayer": "10 m 바람 11월 7일 14:30 IST",
            "visible": false
          },
          {
            "targetLayer": "델리 NCR 타일 (27.5–31.5°N, 76–80°E)",
            "visible": true
