    "2969690f-777f-54e4-bca8-17f04c68b443": {
      "type": "StorySegmentLayer",
      "name": "9. 160자 안에 무엇·언제·어디·왜·어떻게",
      "visible": true,
      "parameters": {
        "zoom": 10.46,
        "extent": [
