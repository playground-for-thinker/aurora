    "b6e004d7-ec36-5ee9-b838-4bc877d1446b": {
      "type": "StorySegmentLayer",
      "name": "7. 11월 7일 05:30 IST, 가장 심각한 곳",
      "visible": true,
      "parameters": {
        "zoom": 12.1,
        "extent": [
          8579998.73,
          3312159.86,
