    "c1896115-b9fc-5632-8f9e-49e098de3061": {
      "type": "StorySegmentLayer",
      "name": "6. 5 Nov 17:30 IST, initial conditions and the forecast run",
      "visible": true,
      "parameters": {
        "zoom": 7.65,
        "extent": [
          7514065.63,
          3061141.04,
          9072538.5,
          3829123.84
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "<div style='font-size:18px; line-height:1.55; min-height:84vh;'><div style='font-size:14px; color:#64748b; letter-spacing:.03em; margin:0 0 8px;'>3 · S1 · S2 · Weather: Aurora 1.5 · Pollutants: synthetic (CAMS needs an account)</div><p style='margin:0 0 10px;'>At 12 UTC (17:30 IST) two <code style='background:rgba(100,116,139,.18); padding:0 4px; border-radius:4px; font-size:.92em;'>Batch</code> objects are built from the CAMS 00/12 UTC analysis and ERA5 06/12 UTC, plus the static pickles. Air Pollution runs 4 steps (+12/24/36/48 h); Aurora 1.5 runs 8 steps × 6 sub-steps (+1…+48 h) on one GPU or on Foundry. Ten minutes later the fields are interpolated to ten sites, the 12-hourly concentrations to hourly, and stagnant hours are flagged from 1.5's hourly mixing height and wind.</p></div>",
          "image": "",
          "imageCaption": "",
          "paneAlignment": "start",
          "panelWidth": "50%"
        },
        "transition": {
          "type": "smooth",
