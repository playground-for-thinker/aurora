    "ba9dde96-1655-59ad-a284-42ddd44a5be9": {
      "type": "StorySegmentLayer",
      "name": "15. Per-site linear bias correction",
      "visible": true,
      "parameters": {
        "zoom": 10.46,
        "extent": [
          8421319.48,
          3274212.69,
          8643958.46,
          3382011.46
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "<div style='font-size:18px; line-height:1.55; min-height:84vh;'><div style='font-size:14px; color:#64748b; letter-spacing:.03em; margin:0 0 8px;'>Roadmap run 2 · observation correction · Additional method · Synthetic observations</div><p style='margin:0 0 10px;'>A straight line obs = a + b × pred is fitted per site by least squares and the RMSE before and after correction compared. Real CPCB observations have no public API and must be scraped, so the procedure runs on <b>synthetic observations</b> (the model assumed to read 15% low at traffic sites and 8% high at residential sites, plus noise). With only five 12-hourly samples the coefficients are illustrative.</p><table style='border-collapse:collapse; width:100%; font-size:16px; margin:6px 0 10px;'><thead><tr><th style='text-align:left; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>Site</th><th style='text-align:right; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>a</th><th style='text-align:right; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>b</th><th style='text-align:right; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>n</th><th style='text-align:right; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>RMSE before</th><th style='text-align:right; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>RMSE after</th></tr></thead><tbody><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Anand Vihar</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>201.9</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>0.36</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>5</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>44.2</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>22.5</td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>ITO</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>41.8</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>1.01</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>5</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>47.5</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>13.3</td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Punjabi Bagh</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>52.8</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>0.67</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>5</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>22.8</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>4.0</td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Rohini</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>-30.6</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>1.06</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>5</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>19.5</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>5.8</td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Jahangirpuri</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>-11.2</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>1.11</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>5</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>19.5</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>11.2</td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>R K Puram</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>-4.7</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>0.91</td><td style='text-align:right; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:nowrap;'>5</td><td style='text-align:right