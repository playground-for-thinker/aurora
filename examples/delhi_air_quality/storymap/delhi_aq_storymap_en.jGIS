    "93323641-31b6-58bb-a749-c9d5d7b6c55d": {
      "type": "StorySegmentLayer",
      "name": "7. 18:30 IST, the evening alert",
      "visible": true,
      "parameters": {
        "zoom": 10.46,
        "extent": [
          8421319.48,
          3274212.69,
          8643958.46,
          3382011.46
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "<div style='font-size:18px; line-height:1.55; min-height:84vh;'><div style='font-size:14px; color:#64748b; letter-spacing:.03em; margin:0 0 8px;'>3 · S3 · S4 · Pollutants: synthetic (CAMS needs an account) · Additional method</div><p style='margin:0 0 10px;'>The first forecast hour. All of Delhi is already \"Very Poor\" or worse, with traffic sites (Anand Vihar, ITO, Gurugram) highest. Per-site AQI and GRAP stage are computed and the one-line push/SMS message goes out; operators get a briefing with the city headline and per-site detail.</p><p style='margin:0 0 10px;'><b>Citizen short message · Hindi</b></p><pre style='font-size:15px; line-height:1.45; white-space:pre-wrap; background:rgba(100,116,139,.12); padding:8px 11px; border-radius:8px; margin:6px 0 10px;'>[वायु गुणवत्ता चेतावनी] Anand Vihar: अधिकतम AQI 500 (गंभीर), 07 Nov 05:30 IST के आसपास। मुख्य प्रदूषक PM10, PM2.5 अधिकतम 321 µg/m³। स्वस्थ लोग भी प्रभावित।</pre><p style='margin:0 0 10px;'><b>City headline</b></p><pre style='font-size:15px; line-height:1.45; white-space:pre-wrap; background:rgba(100,116,139,.12); padding:8px 11px; border-radius:8px; margin:6px 0 10px;'>Delhi-NCR outlook: median peak AQI 433 (Severe); worst site Anand Vihar at AQI 500 (Severe) around 07 Nov 05:30 IST. Corresponds to GRAP Stage 4.</pre></div>",
          "image": "",
          "imageCaption": "",
          "paneAlignment": "start",
          "panelWidth": "50%"
        },
