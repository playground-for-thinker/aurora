    "276514ce-c832-51da-9660-4adc760257b7": {
      "type": "StorySegmentLayer",
      "name": "18. Re-issue at 00 and 12 UTC",
      "visible": true,
      "parameters": {
        "zoom": 7.65,
        "extent": [
          7514065.63,
          3061141.04,
          9072538.5,
          3829123.84
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "<div style='font-size:18px; line-height:1.55; min-height:84vh;'><div style='font-size:14px; color:#64748b; letter-spacing:.03em; margin:0 0 8px;'>Roadmap run 5 · automation · Additional method</div><p style='margin:0 0 10px;'>The cron script generated by the pipeline. It runs at 02:30 and 14:30 UTC (08:00 and 20:00 IST), after the analyses arrive, and writes outputs to a dated folder. The data in this story map are themselves the result of the same command (<code style='background:rgba(100,116,139,.18); padding:0 4px; border-radius:4px; font-size:.92em;'>delhi_aq.py</code>).</p><pre style='font-size:15px; line-height:1.45; white-space:pre-wrap; background:rgba(100,116,139,.12); padding:8px 11px; border-radius:8px; margin:6px 0 10px;'>#!/usr/bin/env bash\n# Re-issue the Delhi air-quality bulletin after each 00/12 UTC analysis becomes available.\n# crontab -e  -&gt;  30 2,14 * * *  /path/to/run_delhi_aq_cron.sh &gt;&gt; /var/log/delhi_aq.log 2&gt;&amp;1\nset -euo pipefail\ncd \"$(dirname \"$0\")\"\npython delhi_aq.py --mode foundry --hours 48 --plot --out \"outputs/$(date -u +%Y-%m-%dT%H)\" -v</pre></div>",
