    "dd150d0f-bd3b-5aee-8612-2e31aa56d7d3": {
      "type": "StorySegmentLayer",
      "name": "12. Per-site summary",
      "visible": true,
      "parameters": {
        "zoom": 10.46,
        "extent": [
          8421319.48,
          3274212.69,
          8643958.46,
          3382011.46
