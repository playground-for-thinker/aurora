    "1865902a-d85b-550b-bd0e-36486e716487": {
      "type": "StorySegmentLayer",
      "name": "1. One line of air-quality warning that reaches a citizen",
      "visible": true,
      "parameters": {
        "zoom": 1.97,
        "extent": [
          -21150703.25,
          -6446275.84,
          18924313.43,
          11753184.62
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "<div style='font-size:18px; line-height:1.55; min-height:84vh;'><div style='font-size:14px; color:#64748b; letter-spacing:.03em; margin:0 0 8px;'>Aurora 1.5 + Aurora Air Pollution · story map</div><p style='margin:0 0 10px;'>Aurora is Microsoft Research's foundation model for the Earth system. This story follows it from a 48-hour forecast for New Delhi to a CPCB AQI, a GRAP stage and a message in Hindi, English and Korean. The map starts at the world and descends to India, the capital region, Delhi and the worst-hit site.</p><h3 style='font-size:20px; margin:12px 0 6px;'>How results are labelled</h3><ul style='margin:0 0 10px 22px; padding:0;'><li style='margin:0 0 5px;'><b>Aurora direct</b> — computed by an Aurora model from a real initial condition</li><li style='margin:0 0 5px;'><b>Additional method</b> — analysis added on top of Aurora output by statistics, rules or software (AQI conversion, stagnation rule, bias correction, delivery, scheduling)</li><li style='margin:0 0 5px;'><b>Synthetic</b> — example values produced without running the model (demo mode, stand-ins for data that needs an account)</li></ul><table style='border-collapse:collapse; width:100%; font-size:16px; margin:6px 0 10px;'><thead><tr><th style='text-align:left; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>Item</th><th style='text-align:left; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>Source</th></tr></thead><tbody><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Initial time</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>2025-11-05 12:00:00 UTC</td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Weather (mixing height, wind, temperature)</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Aurora 1.5 (ARCO-ERA5 initial condition) — Aurora direct</td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Pollutants (PM2.5, PM10, …)</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>synthetic — CAMS data needs an Atmosphere Data Store account, so stand-in values were used</td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Ensemble</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Aurora 1.5 Ensemble (3 members) — Aurora direct</td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>AQI, GRAP, stagnation rule, correction, delivery, scheduling</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>additional methods (CPCB formula, rules, least squares, software)</td></tr></tbody></table><p style='margin:0 0 10px;'>Use the ▶ button to move to the next scene; the map follows. In map scenes the ⓘ (Identify) button lets you click cells and sites for their values.</p></div>",
          "image": "",
          "imageCaption": "",
          "paneAlignment": "start",
          "panelWidth": "50%"
        },
        "transition": {
          "type": "smooth",
          "time": 2.0
        },
        "layerOverride": [
          {
            "targetLayer": "AQI 5 Nov 18:30 IST",
            "visible": false
          },
          {
            "targetLayer": "AQI 6 Nov 02:30 IST",
            "visible": false
          },
          {
            "targetLayer": "AQI 7 Nov 05:30 IST",
            "visible": false
          },
          {
            "targetLayer": "AQI 7 Nov 14:30 IST",
            "visible": false
          },
          {
            "targetLayer": "P(stagnant) 7 Nov 05:30 IST",
            "visible": false
          },
          {
            "targetLayer": "0.25° grid (Aurora 1.5)",
            "visible": false
          },
          {
            "targetLayer": "One 0.4° cell (Aurora Air Pollution)",
            "visible": false
          },
          {
            "targetLayer": "10 m wind 6 Nov 02:30 IST",
            "visible": false
