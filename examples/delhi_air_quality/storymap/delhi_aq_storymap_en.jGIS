    "c67849c2-bb8d-55f9-b505-69ae46706293": {
      "type": "StorySegmentLayer",
      "name": "5. Who receives what",
      "visible": true,
      "parameters": {
        "zoom": 7.65,
        "extent": [
          7514065.63,
          3061141.04,
          9072538.5,
          3829123.84
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "<div style='font-size:18px; line-height:1.55; min-height:84vh;'><div style='font-size:14px; color:#64748b; letter-spacing:.03em; margin:0 0 8px;'>1 · Cast · Pollutants: synthetic (CAMS needs an account)</div><table style='border-collapse:collapse; width:100%; font-size:16px; margin:6px 0 10px;'><thead><tr><th style='text-align:left; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>Role</th><th style='text-align:left; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>Wants</th><th style='text-align:left; padding:4px 7px; border-bottom:2px solid rgba(100,116,139,.5); color:#64748b; font-size:14px; white-space:nowrap;'>Output</th></tr></thead><tbody><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>General public</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>One line for tonight or tomorrow morning</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'><code style='background:rgba(100,116,139,.18); padding:0 4px; border-radius:4px; font-size:.92em;'>short</code></td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Sensitive groups, carers</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Concrete actions and time windows</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'><code style='background:rgba(100,116,139,.18); padding:0 4px; border-radius:4px; font-size:.92em;'>long</code></td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Operators (DPCC/CAQM)</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Peak time, GRAP basis, trend</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'><code style='background:rgba(100,116,139,.18); padding:0 4px; border-radius:4px; font-size:.92em;'>summary_by_site.csv</code>, <code style='background:rgba(100,116,139,.18); padding:0 4px; border-radius:4px; font-size:.92em;'>bulletin_*.md</code></td></tr><tr><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Data/ML engineers</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'>Reproducible pipeline</td><td style='text-align:left; padding:4px 7px; border-bottom:1px solid rgba(100,116,139,.25); white-space:normal;'><code style='background:rgba(100,116,139,.18); padding:0 4px; border-radius:4px; font-size:.92em;'>--mode local|foundry</code></td></tr></tbody></table><p style='margin:0 0 10px;'>Map: the AQI tile at the first forecast hour (5 Nov 18:30 IST). Colors are CPCB categories.</p></div>",
