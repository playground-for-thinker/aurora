    "ba9dde96-1655-59ad-a284-42ddd44a5be9": {
      "type": "StorySegmentLayer",
      "name": "15. Per-site linear bias correction",
      "visible": true,
      "parameters": {
        "zoom": 10.46,
        "extent": [
          8532638.97,
          3274212.69,
          8643958.46,
          3382011.46
        ],
        "enableIdentify": true,
        "content": {
          "contentMode": "map",
          "markdown": "*Roadmap run 2 · observation correction · Additional method · Synthetic observations*\n\nA straight line obs = a + b × pred is fitted per site by least squares and the RMSE before and after correction compared. Real CPCB observations have no public API and must be scraped, so the procedure runs on **synthetic observations** (the model assumed to read 15% low at traffic sites and 8% high at residential sites, plus noise). With only five 12-hourly samples the coefficients are illustrative.\n\n| Site | a | b | n | RMSE before | RMSE after |\n| --- | ---: | ---: | ---: | ---: | ---: |\n| Anand Vihar | 201.9 | 0.36 | 5 | 44.2 | 22.5 |\n| ITO | 41.8 | 1.01 | 5 | 47.5 | 13.3 |\n| Punjabi Bagh | 52.8 | 0.67 | 5 | 22.8 | 4.0 |\n| Rohini | -30.6 | 1.06 | 5 | 19.5 | 5.8 |\n| Jahangirpuri | -11.2 | 1.11 | 5 | 19.5 | 11.2 |\n| R K Puram | -4.7 | 0.91 | 5 | 34.0 | 25.3 |\n| Dwarka Sector 8 | 7.8 | 0.92 | 5 | 9.8 | 5.4 |\n| Okhla Phase 2 | 63.8 | 0.77 | 5 | 16.1 | 10.9 |\n| Noida Sector 62 | -8.6 | 0.96 | 5 | 25.5 | 18.3 |\n| Gurugram Vikas Sadan | 189.4 | 0.42 | 5 | 48.7 | 15.2 |\n",
          "image": "",
          "imageCaption": ""
        },
